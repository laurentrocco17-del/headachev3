    local function startFly()
        local char = LP.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        if PC.flyBV then PC.flyBV:Destroy() end
        if PC.flyBG then PC.flyBG:Destroy() end
        PC.flyBV = Instance.new("BodyVelocity")
        PC.flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        PC.flyBV.Velocity = Vector3.zero
        PC.flyBV.Parent = root
        PC.flyBG = Instance.new("BodyGyro")
        PC.flyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        PC.flyBG.P = 9e4
        PC.flyBG.CFrame = root.CFrame
        PC.flyBG.Parent = root
        if PC.flyConn then PC.flyConn:Disconnect() end
        PC.flyConn = RS.RenderStepped:Connect(function()
            if not cfg.flyEnabled then return end
            local c = LP.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if not r or not PC.flyBV or not PC.flyBG then return end
            local cam = workspace.CurrentCamera
            local dir = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end
            if dir.Magnitude > 0 then
                PC.flyBV.Velocity = dir.Unit * cfg.flySpeed
            else
                PC.flyBV.Velocity = Vector3.zero
            end
            PC.flyBG.CFrame = cam.CFrame
        end)
    end
