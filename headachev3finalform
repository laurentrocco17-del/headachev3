    PC.cls.MouseButton1Click:Connect(function()
        PC.win.Visible = false
    end)

    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if PC.awaitingBind == "tele" then
            cfg.teleKey = input.KeyCode
            PC.btnKeyTele.Text = "TELE: " .. input.KeyCode.Name
            PC.awaitingBind = nil
            return
        end
        if PC.awaitingBind == "void" then
            cfg.voidKey = input.KeyCode
            PC.btnKeyVoid.Text = "VOID: " .. input.KeyCode.Name
            PC.awaitingBind = nil
            return
        end
        if PC.awaitingBind == "fly" then
            cfg.flyKey = input.KeyCode
            PC.btnKeyFly.Text = "FLY: " .. input.KeyCode.Name
            PC.awaitingBind = nil
            return
        end
        if input.KeyCode == cfg.teleKey then
            PC.setTele(not cfg.teleEnabled)
        elseif input.KeyCode == cfg.voidKey then
            PC.setVoid(not cfg.voidEnabled)
        elseif input.KeyCode == cfg.flyKey then
            PC.setFly(not cfg.flyEnabled)
        end
    end)

    PC.btnKeyTele.MouseButton1Click:Connect(function()
        PC.awaitingBind = "tele"
        PC.btnKeyTele.Text = "PRESS..."
    end)

    PC.btnKeyVoid.MouseButton1Click:Connect(function()
        PC.awaitingBind = "void"
        PC.btnKeyVoid.Text = "PRESS..."
    end)

    PC.btnKeyFly.MouseButton1Click:Connect(function()
        PC.awaitingBind = "fly"
        PC.btnKeyFly.Text = "PRESS..."
    end)

    Players.PlayerAdded:Connect(function(p)
        PC.refreshList()
        if cfg.espEnabled and p ~= LP then
            p.CharacterAdded:Connect(function()
                task.wait(0.5)
                if cfg.espEnabled then PC.applyHighlight(p) end
            end)
        end
    end)

    Players.PlayerRemoving:Connect(function(p)
        PC.clearHighlight(p)
        PC.lastSeen[p] = nil
        PC.lastVel[p] = nil
        PC.refreshList()
    end)

    LP.CharacterAdded:Connect(function()
        PC.bgLockedTarget = nil
        PC.antiAimOrigin = nil
        task.wait(0.5)
        if cfg.noclip then PC.setNoclip(true) end
        if cfg.rapidAttack then
            local c = LP.Character
            if c then
                for _, t in ipairs(c:GetChildren()) do
                    if t:IsA("Tool") then PC.hookToolRapidAttack(t) end
                end
            end
        end
        if cfg.flyEnabled then
            task.wait(0.2)
            PC.startFly()
        end
    end)

    local function setupChar(char)
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") then
                if PC.isMelee(child) then
                    PC.hookToolRapidAttack(child)
                    child.Activated:Connect(function()
                        if not cfg.hitSound then return end
                        local before = {}
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p ~= LP then
                                local pc = p.Character
                                if pc then
                                    local h = pc:FindFirstChildOfClass("Humanoid")
                                    if h then before[p] = h.Health end
                                end
                            end
                        end
                        task.wait(0.08)
                        for p, hp in pairs(before) do
                            local pc = p.Character
                            if pc then
                                local h = pc:FindFirstChildOfClass("Humanoid")
                                if h and h.Health < hp then
                                    PC.hitSound:Play()
                                    return
                                end
                            end
                        end
                    end)
                end
            end
        end
        char.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then setupChar(char) end
        end)
    end

    if LP.Character then setupChar(LP.Character) end
    LP.CharacterAdded:Connect(setupChar)

    spawn(function()
        while true do
            local dt = task.wait(0.5)
            if cfg.teleEnabled then
                if cfg.useAll then
                    if tick() - PC.lastCycle >= cfg.teleDelay then
                        PC.lastCycle = tick()
                        PC.refreshPlayers()
                        if #PC.players > 0 then
                            PC.playerIndex = PC.playerIndex % #PC.players + 1
                            local p = PC.players[PC.playerIndex]
                            if p then
                                PC.teleportTo(p)
                                PC.statTgt.Text = "-> " .. p.Name
                            end
                        end
                    end
                elseif cfg.selected and cfg.selected.Parent then
                    if tick() - PC.lastTele >= cfg.teleDelay then
                        PC.lastTele = tick()
                        if PC.teleportTo(cfg.selected) then
                            PC.statTgt.Text = "-> " .. cfg.selected.Name
                        end
                    end
                end
            end
        end
    end)

    spawn(function()
        local fps = 0
        local frames = 0
        local last = tick()
        while true do
            local dt = task.wait(1)
            frames = frames + 1
            if tick() - last >= 1 then
                fps = frames
                frames = 0
                last = tick()
                PC.fpsText.Text = "FPS: " .. fps
                local ok, ping = pcall(function()
                    return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
                end)
                if ok and ping then
                    PC.pingText.Text = "PING: " .. math.floor(ping) .. "ms"
                end
            end
        end
    end)

    spawn(function()
        while true do
            task.wait(0.1)
            PC.rainbowHue = (PC.rainbowHue + 0.01) % 1
            if cfg.espEnabled and cfg.espColor == PC.RAINBOW_IDX then
                PC.refreshColors()
            end
            if cfg.auraEnabled and cfg.auraColor == PC.RAINBOW_IDX then
                local col = PC.curAuraColor()
                if PC.auraHighlight then
                    PC.auraHighlight.FillColor = col
                    PC.auraHighlight.OutlineColor = col
                end
                if PC.auraLight then PC.auraLight.Color = col end
            end
        end
    end)

    spawn(function()
        while true do
            task.wait(0.25)
            if cfg.fpsOverlay and cfg.combatTimer then
                if PC.inCombat then
                    local t = tick() - PC.combatStart
                    PC.combatLabel.Text = string.format("FIGHT: %.1fs", t)
                    PC.combatLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                    if t > 8 then
                        PC.inCombat = false
                    end
                else
                    PC.combatLabel.Text = "FIGHT: --"
                    PC.combatLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
                end
            end
        end
    end)

    spawn(function()
        while true do
            task.wait(1)
            if cfg.voidTrack and cfg.suspicious then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LP and PC.isSuspicious(p) then
                        if tick() - PC.lastThreatToast > 3 then
                            PC.lastThreatToast = tick()
                            toast("Threat: " .. p.Name, T.warn)
                        end
                    end
                end
            end
        end
    end)

    spawn(function()
        while true do
            task.wait(0.5)
            local c = LP.Character
            if c then
                local h = c:FindFirstChildOfClass("Humanoid")
                if h then
                    local hp = h.Health
                    if hp < PC.lastDamage then
                        PC.inCombat = true
                        PC.combatStart = tick()
                    end
                    PC.lastDamage = hp
                end
            end
        end
    end)

    spawn(function()
        local lastPos = {}
        while true do
            task.wait(0.05)
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP then
                    local c = p.Character
                    local hrp = c and c:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local prev = lastPos[p]
                        if prev and (hrp.Position - prev).Magnitude > 150 then
                            if cfg.suspicious then
                                PC.lastSeen[p] = hrp.Position
                            end
                        end
                        lastPos[p] = hrp.Position
                    end
                end
            end
        end
    end)

    spawn(function()
        while true do
            task.wait(0.5)
            if cfg.cameraFollow then
                local target = PC.camFollowTarget
                if not target or not target.Parent then
                    PC.camFollowTarget = PC.getCamNearestPlayer()
                    target = PC.camFollowTarget
                end
                if target then
                    local tc = target.Character
                    local th = tc and tc:FindFirstChild("Head")
                    if th then
                        local cam = workspace.CurrentCamera
                        cam.CameraType = Enum.CameraType.Scriptable
                        local look = CFrame.new(cam.CFrame.Position, th.Position)
                        cam.CFrame = cam.CFrame:Lerp(look, 0.15)
                        local myHum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                        if myHum then
                            myHum.AutoRotate = false
                        end
                    end
                end
            end
        end
    end)

    toast("PHANTOMCORE loaded", T.ok)
end
