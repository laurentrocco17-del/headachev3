    local function refreshConfigList()
        for _, c in ipairs(PC.configList:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        cfg.activeConfig = ""
        if not listfiles or not isfolder then return end
        if not isfolder(PC.CONFIG_DIR) then
            pcall(function() makefolder(PC.CONFIG_DIR) end)
        end
        local ok, files = pcall(function() return listfiles(PC.CONFIG_DIR) end)
        if not ok or not files then return end
        for _, path in ipairs(files) do
