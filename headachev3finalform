    local function applyVoid()
        local r = PC.getRoot()
        if not r then return end
        if cfg.holding and cfg.holdTarget then
            local tc = cfg.holdTarget.Character
            local th = tc and tc:FindFirstChild("Head")
            if th then
                r.CFrame = CFrame.new(th.Position + Vector3.new(0, 1, 0))
                r.Velocity = Vector3.new(0, 0, 0)
                r.RotVelocity = Vector3.new(0, 0, 0)
                return
            else
                clearHold()
            end
        end
        local f = cfg.voidForce
        if f < 1 then f = 1 end
        local function rs()
            local m = PC.rng:NextNumber(f * 0.7, f)
            if PC.rng:NextInteger(0, 1) == 0 then return -m end
            return m
        end
        r.Velocity = Vector3.new(rs(), PC.rng:NextNumber(f * 0.7, f), rs())
        r.RotVelocity = Vector3.new(
            PC.rng:NextNumber(-10000, 10000),
            PC.rng:NextNumber(-10000, 10000),
            PC.rng:NextNumber(-10000, 10000)
        )
    end
